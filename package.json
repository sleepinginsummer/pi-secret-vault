{
  "name": "pi-secret-vault",
  "version": "0.1.0",
  "description": "Keep credentials out of the prompt: encrypted vault, value-based masking, and only high-precision shape rules",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sleepinginsummer/pi-secret-vault.git"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "secrets",
    "credentials",
    "api-keys",
    "tokens",
    "redaction",
    "masked-input",
    "env",
    "security"
  ],
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "corpus": "node --experimental-strip-types --no-warnings scripts/scan-corpus.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^1.2.0",
    "@earendil-works/pi-coding-agent": "^1.2.0",
    "@earendil-works/pi-tui": "^1.2.0",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@earendil-works/pi-tui": "1.2.0",
    "@types/node": "^22.20.2",
    "typebox": "1.3.7",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  }
}
